# Copy this file to .env and change the values.
# If DATABASE_URL is not set, a SQLite file is used.

# Shared secret for write endpoints. Send it as:
# Authorization: Bearer <WRITE_API_TOKEN>
# If omitted or empty, all write endpoints return 401.
WRITE_API_TOKEN=

# MySQL example (also run: pip install pymysql)
# DATABASE_URL=mysql+pymysql://username:password@localhost/quizmaster
